CREATE OR REPLACE FUNCTION public."Связь с уязвимостями"()
	RETURNS trigger
	LANGUAGE plpgsql
	VOLATILE PARALLEL UNSAFE
AS $BODY$
DECLARE
    stat character varying(50);
BEGIN
    SELECT "Статус" INTO stat
    FROM public."Уязвимость"
    WHERE "ID уязвимости" = NEW."ID уязвимости";
    IF stat = 'Исправлена' THEN
        UPDATE public."Уязвимость" 
        SET "Статус" = 'Повторно открыта',
            "Время устранения" = NULL
        WHERE "ID уязвимости" = NEW."ID уязвимости";
        RAISE NOTICE 'Уязвимость % переведена из статуса "Исправлена" в "Повторно открыта"', NEW."ID уязвимости";
    END IF;
    RETURN NEW;
END;
$BODY$;

DROP TRIGGER IF EXISTS "Контроль связи с уязвимостями" ON public."Связь уяз_инц";
CREATE TRIGGER "Контроль связи с уязвимостями"
    BEFORE INSERT ON public."Связь уяз_инц"
    FOR EACH ROW
    EXECUTE FUNCTION public."Связь с уязвимостями"();

