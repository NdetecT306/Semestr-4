DROP TABLE IF EXISTS public."Объект КИ" CASCADE;
CREATE TABLE IF NOT EXISTS public."Объект КИ"
(
    "ID объекта" integer NOT NULL,
    "Название" character varying(50) COLLATE pg_catalog."default" NOT NULL,
    "Тип" character varying(50) COLLATE pg_catalog."default" NOT NULL,
    "Уровень критичности" integer NOT NULL,
    "Адрес" character varying(50) COLLATE pg_catalog."default" NOT NULL,
    "Номер телефона" character varying(15) COLLATE pg_catalog."default" NOT NULL,
    "Описание" text COLLATE pg_catalog."default",
    CONSTRAINT "Объект КИ_pkey" PRIMARY KEY ("ID объекта")
)
TABLESPACE pg_default;

ALTER TABLE IF EXISTS public."Объект КИ"
    OWNER TO postgres;