CREATE OR REPLACE FUNCTION public."Последнее изменение"()
	RETURNS trigger
	LANGUAGE 'plpgsql'
	VOLATILE PARALLEL UNSAFE
AS $BODY$
BEGIN
    NEW."Дата и время изменения" = CURRENT_TIMESTAMP(0);
    RETURN NEW;
END;
$BODY$;

DROP TRIGGER IF EXISTS "Редактор времени инцидента" ON public."Инциденты";
CREATE TRIGGER "Редактор времени инцидента"
    BEFORE UPDATE ON public."Инциденты"
    FOR EACH ROW
    EXECUTE FUNCTION public."Последнее изменение"();

