CREATE OR REPLACE FUNCTION public."Проверка на возможность удалить"()
	RETURNS trigger
	LANGUAGE 'plpgsql'
	VOLATILE PARALLEL UNSAFE
AS $BODY$
BEGIN
    IF OLD."Текущее состояние" NOT IN ('Закрыт') THEN
    	RAISE EXCEPTION 'Только завершённые инциденты могут быть удалены.';
    END IF;
    RETURN OLD;
END;
$BODY$;

DROP TRIGGER IF EXISTS "Удаление особо важных данных" ON public."Инциденты";
CREATE TRIGGER "Удаление особо важных данных"
    BEFORE DELETE ON public."Инциденты"
    FOR EACH ROW
    EXECUTE FUNCTION public."Проверка на возможность удалить"();

