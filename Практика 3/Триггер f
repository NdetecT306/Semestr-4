CREATE OR REPLACE FUNCTION public."ХЭШ"()
	RETURNS trigger
	LANGUAGE 'plpgsql'
	VOLATILE PARALLEL UNSAFE
AS $BODY$
BEGIN
    IF LENGTH(NEW."Пароль") != 64 OR NEW."Пароль" ~ '[^a-f0-9]' THEN
        NEW."Пароль" = encode(sha256(NEW."Пароль"::bytea), 'hex');
    END IF;
    RETURN NEW;
END;
$BODY$;

DROP TRIGGER IF EXISTS "Хэшнутый триггер" ON public."Сотрудники";
CREATE TRIGGER "Хэшнутый триггер"
    BEFORE INSERT OR UPDATE ON public."Сотрудники"
    FOR EACH ROW
    EXECUTE FUNCTION public."ХЭШ"();

